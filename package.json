{
  "name": "tactical-hex-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Tactical Hex Trainer (THT): turn-based hex-grid tactical wargame for company-level officer training. Offline, LAN-hosted.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @tht/client && npm run build -w @tht/server",
    "dev:server": "npm run dev -w @tht/server",
    "dev:client": "npm run dev -w @tht/client",
    "start": "node --no-warnings=ExperimentalWarning packages/server/dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/engine && tsc -p packages/server && tsc -p packages/client",
    "gen:maps": "tsx tools/mapgen.ts",
    "gen:docs": "tsx tools/gen-rules-doc.ts",
    "validate:data": "tsx tools/validate-data.ts",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
